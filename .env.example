# Flask
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=1

# SMTP (Gmail) for OTP delivery. Use a Google App Password (not your raw password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=RUMAH KARIR <your-email@gmail.com>

# Admin (hard-coded but configurable)
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin123
